# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env не попадает в git.

# https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF

# ID админов через запятую
ADMIN_ID=123456789

# Группа для логов о новых пользователях и ошибках (бот должен быть в ней)
LOG_GROUP_ID=-1001234567890

# Префиксы команд (необязательно)
COMMAND_PREFIX=#|.|/|!|,

# Количество одновременных обработчиков (необязательно)
WORKERS=16
